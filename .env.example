# Optional: without these values the skeleton runs in honest DEMO/CONFIGURATION status.
# The only required database variable. For Neon, paste the EU project's pooled/direct
# PostgreSQL connection string here; keep TLS enabled with sslmode=require.
DATABASE_URL=
# Integration tests require this explicit variable and never fall back to DATABASE_URL.
TEST_DATABASE_URL=
# Migrations NEVER run in the Vercel request/cold-start path by default; apply the
# schema explicitly against the real database BEFORE a pilot:
#   DATABASE_URL=... bun run db:migrate   (exit 0 = applied, nonzero = failed)
# Opt-in ONLY for a single long-running Bun process (NOT recommended on Vercel,
# where every cold start would re-run the migration): set to exactly '1'.
RUN_MIGRATIONS_ON_START=
# Milliseconds a request waits for background DB readiness (RUN_MIGRATIONS_ON_START=1)
# before failing fast with a classified 503 DATABASE_UNAVAILABLE (default 3000).
# Keeps a hung/sleeping database from turning requests into platform timeouts (504).
DB_READINESS_TIMEOUT_MS=
# 32-byte base64 or 64-char hex key; use a managed secret provider in production.
MFA_ENCRYPTION_KEY=
# Historical Tiger Cloud project/API values. Tiger is not selected for production
# because no suitable EU region was available in the owner check. Never commit values.
TIGER_PUBLIC_KEY=
TIGER_SECRET_KEY=
TIGER_PROJECT_ID=
SESSION_SECRET=
# Exact CORS origin of the published frontend (no trailing slash, no path).
# Required for production; PUBLIC_SITE_ORIGIN is the legacy alias.
FRONTEND_ORIGIN=
PUBLIC_SITE_ORIGIN=
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_PRIVATE_KEY=
# Google Wallet Loyalty issuer ID (numeric). Required in every mode.
GOOGLE_ISSUER_ID=
# --- Preferred keyless mode: Workload Identity Federation (no service-account JSON key) ---
# External-account credentials JSON from GCP Workload Identity Federation
# (audience of the pool provider + service_account_impersonation_url). No private
# keys inside. See GOOGLE_WALLET_SETUP.md for the owner-side GCP/Vercel setup.
GOOGLE_EXTERNAL_ACCOUNT_JSON=
# Vercel injects the OIDC token as the x-vercel-oidc-token request header in
# Functions (read automatically by the wallet route) or as VERCEL_OIDC_TOKEN in
# Builds / local development (vercel env pull). Do not store a token for Functions.
VERCEL_OIDC_TOKEN=
# Local-dev ADC convenience: path to an external_account JSON file, or a classic
# service_account JSON file. Read at runtime; this code never writes credential files.
GOOGLE_APPLICATION_CREDENTIALS=
# --- Fallback mode (optional): classic service-account key. Never required in keyless mode. ---
# Preferred: complete service-account JSON (never commit). Alternative split values below.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM private key; shell/env representation may use literal \\n escapes.
GOOGLE_PRIVATE_KEY=
# Optional provider-agnostic SMTP. All five values are required; otherwise sending stays not_configured.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
# Required before any email delivery/logging: keyed recipient pseudonymisation secret (>=32 chars).
# Rotation intentionally changes hashes; existing hashes cannot be matched across rotations.
COMMUNICATION_HASH_SECRET=
# --- RLS / production-role verification (opt-in diagnostic, read-only) ---
# Explicit opt-in only — there is NO fallback to DATABASE_URL. Run `bun run rls-verify`
# with the APP-ROLE connection string (as-role mode); optionally RLS_VERIFY_ROLE for
# named-role mode via an admin connection. Prints an anonymized JSON report; never
# logs the URL. See RLS_AUTH_P1.md Teil C.
RLS_VERIFY_DATABASE_URL=
RLS_VERIFY_ROLE=
RLS_VERIFY_SCHEMA=public
